{
  "name": "qimmah",
  "version": "1.0.0",
  "description": "قِمّة — مرشدك الهادئ نحو صحة أفضل: تمارين وتغذية وقياسات وأهداف بالعربية. Qimmah — a calm, Arabic-first health & fitness companion.",
  "private": true,
  "type": "module",
  "license": "Commercial",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "typecheck": "tsc -b --noEmit",
    "perf:budget": "node scripts/check-perf-budget.mjs",
    "db:verify": "node scripts/db/run-verify-rls.mjs",
    "qa:p11.5": "node scripts/run-p11.5-qa.mjs",
    "build:media": "node scripts/build-exercise-media.mjs",
    "media:gifs": "node scripts/fetch-workoutx-media.mjs",
    "media:gifs:probe": "node scripts/fetch-workoutx-media.mjs --probe",
    "proof:media": "node scripts/run-p3-media-proof.mjs",
    "proof:achievements": "node scripts/run-achievements-proof.mjs",
    "proof:p4a3": "node scripts/run-p4a3-proof.mjs && node scripts/run-p4a3-ssr-proof.mjs",
    "proof:p5reset": "node scripts/run-p5-reset-proof.mjs",
    "proof:p5plan": "node scripts/run-p5-plan-proof.mjs",
    "proof:p5medals": "node scripts/run-p5-medals-shot.mjs",
    "proof:p8a2off": "node scripts/run-p8a2-off-proof.mjs",
    "proof:p8a3": "node scripts/run-p8a3-proof.mjs",
    "proof:p10a5": "node scripts/run-p10-a5-proof.mjs",
    "proof:p10qa": "node scripts/run-p10-integration-qa.mjs",
    "test:active-session": "node scripts/run-active-session-proof.mjs",
    "test:today-v2": "node scripts/run-today-v2-model-proof.mjs",
    "test:progress-v2": "node scripts/run-progress-v2-proof.mjs",
    "test:data-portability": "node scripts/run-data-portability-proof.mjs",
    "test:portability": "node scripts/run-portability-proof.mjs",
    "test:notifications": "node scripts/run-notifications-proof.mjs",
    "test:insights": "node scripts/run-insights-proof.mjs",
    "test:strength": "node scripts/run-strength-proof.mjs",
    "test:sync": "node scripts/run-sync-proof.mjs",
    "test:onboarding-async": "node scripts/run-onboarding-async-proof.mjs",
    "test:fixforward": "node scripts/run-fixforward-proof.mjs",
    "test:isolation": "node scripts/run-isolation-proof.mjs",
    "test:reset-recovery": "node scripts/run-reset-recovery-proof.mjs",
    "test:seed": "node scripts/run-seed-proof.mjs",
    "test:catalog": "node scripts/run-catalog-media-proof.mjs",
    "test:food-db": "node scripts/run-food-db-proof.mjs",
    "test:policy": "node scripts/policy-gates-proof.mjs",
    "test:native-bridge": "node scripts/run-native-bridge-proof.mjs",
    "test:gate": "npm run test:active-session && npm run test:today-v2 && npm run test:progress-v2 && npm run test:data-portability && npm run test:portability && npm run test:notifications && npm run test:insights && npm run test:strength && npm run test:sync && npm run test:onboarding-async && npm run test:fixforward && npm run test:isolation && npm run test:reset-recovery && npm run test:seed && npm run test:catalog && npm run test:food-db && npm run test:coaching && npm run test:policy",
    "test:e2e:onboarding": "node scripts/e2e-onboarding.mjs",
    "test:e2e": "npm run build && node scripts/e2e-onboarding.mjs",
    "test:e2e:journey": "VITE_DESIGN_V2=true npm run build && node scripts/e2e/journey.mjs",
    "test:e2e:auth:preflight": "node scripts/e2e-auth/preflight.mjs",
    "test:e2e:auth": "node scripts/e2e-auth/run.mjs",
    "test:e2e:auth:preload": "node scripts/e2e-auth/preload-images.mjs",
    "coaching:build": "node scripts/coaching/extract-manifest.mjs && node scripts/coaching/build-cues.mjs",
    "test:coaching": "node scripts/coaching/run-coaching-proof.mjs"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.0",
    "@capacitor/core": "^8.4.1",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.4.1",
    "@capacitor/keyboard": "^8.0.5",
    "@capacitor/local-notifications": "^8.2.0",
    "@capacitor/splash-screen": "^8.0.1",
    "@capacitor/status-bar": "^8.0.2",
    "@fontsource/ibm-plex-sans-arabic": "^5.2.9",
    "@fontsource/readex-pro": "^5.2.11",
    "@fontsource/tajawal": "^5.2.7",
    "@supabase/supabase-js": "^2.108.2",
    "@zxing/browser": "^0.2.0",
    "@zxing/library": "^0.22.0",
    "lucide-react": "^0.456.0",
    "react": "^18.3.1",
    "react-body-highlighter": "^2.0.5",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.4.1",
    "@types/node": "^22.20.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@typescript-eslint/eslint-plugin": "^8.13.0",
    "@typescript-eslint/parser": "^8.13.0",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-react-refresh": "^0.4.14",
    "playwright": "^1.61.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3",
    "vite": "^6.4.3"
  }
}
