{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qimmah.app/qae/evaluation.schema.json",
  "title": "QAE Evaluation API (DRAFT)",
  "description": "The only surface hosts see. Every request carries now + all data + manifest reference; every response embeds the manifest that produced it. Nothing is read from ambient state.",
  "$defs": {
    "QuestionDef": {
      "type": "object",
      "required": ["id", "key", "category", "answerType", "affects", "safety", "priority", "required", "skippable", "infoGain", "sinceBankVersion"],
      "properties": {
        "id": { "type": "string" },
        "key": { "type": "string" },
        "category": { "enum": ["basics", "experience", "goals", "availability", "equipment", "safety", "limitations", "preferences", "recovery", "advanced", "clarify"] },
        "answerType": { "enum": ["single", "multi", "number", "slider", "boolean", "rank", "time", "weekdays", "bodyAreas", "equipment", "exercises", "text"] },
        "options": { "type": "array", "items": { "type": "object", "required": ["value"], "properties": { "value": { "type": "string" }, "sets": { "type": "object", "additionalProperties": true } }, "additionalProperties": false } },
        "range": { "type": "object", "properties": { "min": { "type": "integer" }, "max": { "type": "integer" } }, "additionalProperties": false },
        "eligible": { "$ref": "#/$defs/Predicate" },
        "skipIf": { "$ref": "#/$defs/Predicate" },
        "followUps": { "type": "array", "items": { "type": "object", "required": ["when", "ask"], "properties": { "when": { "$ref": "#/$defs/Predicate" }, "ask": { "type": "array", "items": { "type": "string" } } }, "additionalProperties": false } },
        "affects": { "type": "array", "minItems": 1, "items": { "type": "string" }, "description": "verified against profile derivation (closes legacy defect L-QST-2)" },
        "safety": { "enum": ["none", "screen", "restrict", "clear"] },
        "priority": { "type": "integer", "minimum": 0, "maximum": 100 },
        "required": { "type": "boolean" },
        "skippable": { "type": "boolean" },
        "levels": { "type": "array", "items": { "$ref": "core.schema.json#/$defs/ExperienceClass" } },
        "infoGain": { "type": "integer", "minimum": 0, "maximum": 10 },
        "sinceBankVersion": { "type": "integer" }
      },
      "additionalProperties": false
    },
    "Predicate": {
      "description": "Declarative, introspectable condition data (RULE-MODEL §3). Maps 1:1 onto the characterized legacy Condition union.",
      "oneOf": [
        { "type": "object", "required": ["op", "children"], "properties": { "op": { "enum": ["all", "any"] }, "children": { "type": "array", "items": { "$ref": "#/$defs/Predicate" } } }, "additionalProperties": false },
        { "type": "object", "required": ["op", "child"], "properties": { "op": { "const": "not" }, "child": { "$ref": "#/$defs/Predicate" } }, "additionalProperties": false },
        { "type": "object", "required": ["op", "value"], "properties": { "op": { "const": "const" }, "value": { "type": "boolean" } }, "additionalProperties": false },
        { "type": "object", "required": ["op", "path"], "properties": { "op": { "enum": ["eq", "ne", "in", "nin", "gt", "gte", "lt", "lte", "has", "hasAny", "hasNone", "answered", "unanswered", "trendIs", "confidenceAtLeast", "hasFlag", "notFlag", "daysSinceAtLeast", "daysSinceLessThan"] }, "path": { "type": "string" }, "value": {} }, "additionalProperties": false }
      ]
    },

    "AssessRequest": {
      "type": "object",
      "required": ["now", "knowns"],
      "properties": {
        "now": { "$ref": "core.schema.json#/$defs/Now" },
        "knowns": { "type": "object" },
        "answers": { "type": "object" },
        "priorState": { "$ref": "profile.schema.json#/$defs/PartialAthleteState" }
      },
      "additionalProperties": false
    },
    "AssessResponse": {
      "type": "object",
      "required": ["state", "manifest"],
      "properties": {
        "state": { "$ref": "profile.schema.json#/$defs/PartialAthleteState" },
        "finalizedProfile": { "$ref": "profile.schema.json#/$defs/AthleteProfile", "description": "present only when completeness gates pass" },
        "manifest": { "$ref": "core.schema.json#/$defs/RuleSetManifest" }
      },
      "additionalProperties": false
    },

    "SelectQuestionRequest": {
      "type": "object",
      "required": ["now", "state", "history", "budgetConfig"],
      "properties": {
        "now": { "$ref": "core.schema.json#/$defs/Now" },
        "state": { "$ref": "profile.schema.json#/$defs/PartialAthleteState" },
        "history": { "type": "array", "items": { "type": "object", "required": ["questionId"], "properties": { "questionId": { "type": "string" }, "answeredAtEpochMs": { "type": ["integer", "null"] }, "skipped": { "type": "boolean" }, "revisions": { "type": "integer" } }, "additionalProperties": false } },
        "queue": { "type": "array", "items": { "type": "string" } },
        "budgetConfig": { "type": "object", "additionalProperties": { "type": "object", "required": ["min", "max", "hardCap"], "properties": { "min": { "type": "integer" }, "max": { "type": "integer" }, "hardCap": { "type": "integer", "maximum": 20 } }, "additionalProperties": false } }
      },
      "additionalProperties": false
    },
    "SelectQuestionResponse": {
      "type": "object",
      "required": ["question", "stopReason", "offBudget", "manifest"],
      "properties": {
        "question": { "oneOf": [{ "$ref": "#/$defs/QuestionDef" }, { "type": "null" }] },
        "stopReason": { "oneOf": [{ "enum": ["complete", "cap_reached", "exhausted", "consent_pending"] }, { "type": "null" }] },
        "offBudget": { "type": "boolean" },
        "manifest": { "$ref": "core.schema.json#/$defs/RuleSetManifest" }
      },
      "additionalProperties": false
    },

    "GeneratePlanRequest": {
      "type": "object",
      "required": ["now", "profile"],
      "properties": {
        "now": { "$ref": "core.schema.json#/$defs/Now" },
        "profile": { "$ref": "profile.schema.json#/$defs/AthleteProfile" },
        "ramadanContext": { "$ref": "profile.schema.json#/$defs/RamadanContext" },
        "exerciseLibrary": { "type": "array", "items": { "$ref": "plan.schema.json#/$defs/ExerciseMetadata" }, "description": "passed in — the engine holds no library" }
      },
      "additionalProperties": false
    },
    "GeneratePlanResponse": {
      "type": "object",
      "required": ["plan", "safetyVerdict", "validDecisionSpace", "reasonTrace", "manifest"],
      "properties": {
        "plan": { "oneOf": [{ "$ref": "plan.schema.json#/$defs/Plan" }, { "type": "null" }], "description": "null when checkpoint 1 blocks" },
        "safetyVerdict": { "$ref": "proposal.schema.json#/$defs/SafetyVerdict" },
        "validDecisionSpace": { "$ref": "proposal.schema.json#/$defs/ValidDecisionSpace" },
        "reasonTrace": { "$ref": "core.schema.json#/$defs/ReasonTrace" },
        "manifest": { "$ref": "core.schema.json#/$defs/RuleSetManifest" }
      },
      "additionalProperties": false
    },

    "EvaluateWeekRequest": {
      "type": "object",
      "required": ["now", "period", "profile", "currentPlan", "rawObservations", "adaptationHistory"],
      "properties": {
        "now": { "$ref": "core.schema.json#/$defs/Now" },
        "period": { "$ref": "core.schema.json#/$defs/ReviewPeriod" },
        "profile": { "$ref": "profile.schema.json#/$defs/AthleteProfile" },
        "currentPlan": { "$ref": "plan.schema.json#/$defs/Plan" },
        "rawObservations": { "type": "array", "items": { "$ref": "observations.schema.json#/$defs/RawObservation" } },
        "adaptationHistory": { "type": "array", "items": { "$ref": "proposal.schema.json#/$defs/AdaptationHistoryEntry" } },
        "goalLifecycle": { "$ref": "profile.schema.json#/$defs/GoalLifecycleState" },
        "ramadanContext": { "$ref": "profile.schema.json#/$defs/RamadanContext" }
      },
      "additionalProperties": false
    },
    "EvaluateWeekResponse": {
      "type": "object",
      "required": ["trendReport", "dataQualityReport", "proposals", "validDecisionSpace", "reasonTrace", "manifest"],
      "properties": {
        "trendReport": { "$ref": "observations.schema.json#/$defs/TrendReport" },
        "dataQualityReport": { "$ref": "observations.schema.json#/$defs/DataQualityReport" },
        "proposals": { "type": "array", "items": { "$ref": "proposal.schema.json#/$defs/AdaptationProposal" }, "description": "ordered by (priorityClass, priorityScore desc, ruleId); ≤1 major/composite + ≤1 minor" },
        "validDecisionSpace": { "$ref": "proposal.schema.json#/$defs/ValidDecisionSpace" },
        "reasonTrace": { "$ref": "core.schema.json#/$defs/ReasonTrace" },
        "manifest": { "$ref": "core.schema.json#/$defs/RuleSetManifest" }
      },
      "additionalProperties": false
    },

    "CheckActionRequest": {
      "type": "object",
      "description": "Checkpoint 3: applying an accepted proposal, or validating a user-initiated action against the ValidDecisionSpace.",
      "required": ["now", "profile", "currentPlan", "action"],
      "properties": {
        "now": { "$ref": "core.schema.json#/$defs/Now" },
        "profile": { "$ref": "profile.schema.json#/$defs/AthleteProfile" },
        "currentPlan": { "$ref": "plan.schema.json#/$defs/Plan" },
        "action": { "$ref": "proposal.schema.json#/$defs/AdaptationAction" },
        "sourceProposalId": { "type": "string" },
        "latestTrends": { "$ref": "observations.schema.json#/$defs/TrendReport" }
      },
      "additionalProperties": false
    },
    "CheckActionResponse": {
      "type": "object",
      "required": ["verdict", "manifest"],
      "properties": {
        "verdict": { "$ref": "proposal.schema.json#/$defs/SafetyVerdict" },
        "manifest": { "$ref": "core.schema.json#/$defs/RuleSetManifest" }
      },
      "additionalProperties": false
    }
  }
}
