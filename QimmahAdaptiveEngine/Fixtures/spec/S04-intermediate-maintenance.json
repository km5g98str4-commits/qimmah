  "expected": {
    "classification": { "label": "CHARACTERIZED_EXISTING", "expectations": [ { "assert": "trend direction = stable with confidence ≥ moderate (≥4 points, ≥14-day span per characterized thresholds)", "oracleRef": "src/lib/insights/metrics.ts:15-25" } ] },
    "initialPlan": { "label": "NOT_APPLICABLE", "expectations": [ { "assert": "review scenario" } ] },
