{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qimmah.app/schema/food-production/product-1.0.0.json",
  "title": "Qimmah packaged food product record",
  "description": "Canonical, provenance-preserving record for one packaged food product. Nutrition values are always expressed on the basis declared in nutrition_basis. TypeScript source of truth: src/lib/food/productSchema.ts (kept in sync by run-food-production-proof.mjs).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "product_id", "gtin", "gtin_as_source", "name_ar", "name_en", "brand_ar", "brand_en",
    "manufacturer", "country", "market", "category", "serving_size", "serving_unit",
    "servings_per_container", "nutrition_basis", "energy_kcal", "protein_g", "carbs_g",
    "fat_g", "saturated_fat_g", "sugar_g", "fiber_g", "sodium_mg", "micronutrients",
    "ingredients", "allergens", "image_url", "source", "source_record_id", "source_url",
    "source_updated_at", "ingested_at", "confidence", "quality_flags",
    "normalization_version", "schema_version"
  ],
  "properties": {
    "product_id":  { "type": "string", "pattern": "^[a-z_]+:[0-9]{14}$", "description": "<source>:<gtin14> — reproducible, stateless." },
    "gtin":        { "type": "string", "pattern": "^[0-9]{14}$", "description": "Canonical GTIN-14 (zero-padded). Single key space for all GTIN lengths." },
    "gtin_as_source": { "type": "string", "pattern": "^[0-9]{8,14}$", "description": "Code as the source supplied it, for traceability only." },

    "name_ar":      { "type": ["string", "null"], "minLength": 1 },
    "name_en":      { "type": ["string", "null"], "minLength": 1 },
    "brand_ar":     { "type": ["string", "null"], "minLength": 1 },
    "brand_en":     { "type": ["string", "null"], "minLength": 1 },
    "manufacturer": { "type": ["string", "null"], "minLength": 1 },
    "country":      { "type": ["string", "null"], "description": "Marketing country as DECLARED BY THE SOURCE. Never derived from the GS1 prefix." },
    "market":       { "type": "string", "enum": ["SA", "GCC", "GLOBAL"] },
    "category":     { "type": ["string", "null"] },

    "serving_size":           { "type": ["number", "null"], "exclusiveMinimum": 0, "maximum": 5000 },
    "serving_unit":           { "type": ["string", "null"], "enum": ["g", "ml", null] },
    "servings_per_container": { "type": ["number", "null"], "exclusiveMinimum": 0, "maximum": 1000 },

    "nutrition_basis": { "type": "string", "enum": ["per_100g", "per_100ml"] },
    "energy_kcal":     { "type": ["number", "null"], "minimum": 0, "maximum": 950 },
    "protein_g":       { "type": ["number", "null"], "minimum": 0, "maximum": 100 },
    "carbs_g":         { "type": ["number", "null"], "minimum": 0, "maximum": 100 },
    "fat_g":           { "type": ["number", "null"], "minimum": 0, "maximum": 100 },
    "saturated_fat_g": { "type": ["number", "null"], "minimum": 0, "maximum": 100 },
    "sugar_g":         { "type": ["number", "null"], "minimum": 0, "maximum": 100 },
    "fiber_g":         { "type": ["number", "null"], "minimum": 0, "maximum": 100 },
    "sodium_mg":       { "type": ["number", "null"], "minimum": 0, "maximum": 40000 },

    "micronutrients": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "calcium_mg":     { "type": "number", "minimum": 0 },
        "iron_mg":        { "type": "number", "minimum": 0 },
        "potassium_mg":   { "type": "number", "minimum": 0 },
        "magnesium_mg":   { "type": "number", "minimum": 0 },
        "zinc_mg":        { "type": "number", "minimum": 0 },
        "vitamin_a_ug":   { "type": "number", "minimum": 0 },
        "vitamin_c_mg":   { "type": "number", "minimum": 0 },
        "vitamin_d_ug":   { "type": "number", "minimum": 0 },
        "vitamin_b12_ug": { "type": "number", "minimum": 0 },
        "cholesterol_mg": { "type": "number", "minimum": 0 },
        "caffeine_mg":    { "type": "number", "minimum": 0 }
      }
    },

    "ingredients": { "type": ["string", "null"] },
    "allergens":   { "type": ["array", "null"], "items": { "type": "string" } },
    "image_url": {
      "type": "null",
      "description": "ALWAYS null in this version. OFF product images are CC-BY-SA but OFF's own terms warn they carry third-party rights (packaging design, trademarks). Not rights-clear, so not ingested. Field reserved for a future rights-cleared source."
    },

    "source":            { "type": "string", "enum": ["openfoodfacts", "usda_fdc", "qimmah_curated"] },
    "source_record_id":  { "type": "string", "minLength": 1 },
    "source_url":        { "type": ["string", "null"], "format": "uri" },
    "source_updated_at": { "type": ["string", "null"], "format": "date-time" },
    "ingested_at":       { "type": "string", "format": "date-time" },

    "confidence":    { "type": "number", "minimum": 0, "maximum": 1 },
    "quality_flags": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "missing_energy", "missing_macros", "macro_energy_mismatch", "macro_sum_exceeds_mass",
          "energy_density_impossible", "negative_value", "sugar_exceeds_carbs", "fiber_exceeds_carbs",
          "saturated_exceeds_fat", "sodium_out_of_range", "energy_unit_suspect_kj",
          "serving_basis_suspect", "no_arabic_name", "no_english_name", "no_brand",
          "serving_size_implausible"
        ]
      }
    },
    "normalization_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "schema_version":        { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" }
  }
}
