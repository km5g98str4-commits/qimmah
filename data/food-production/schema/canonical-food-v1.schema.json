{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qimmah.app/schemas/food/canonical-food-v1.json",
  "title": "CanonicalFoodV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "product_id",
    "schema_version",
    "normalization_version",
    "gtin",
    "gtin_as_source",
    "name_ar",
    "name_en",
    "brand_ar",
    "brand_en",
    "manufacturer",
    "country",
    "market",
    "category_ar",
    "package_size_value",
    "package_size_unit",
    "package_size_text_raw",
    "serving_size_value",
    "serving_unit",
    "serving_size_text_raw",
    "servings_per_container",
    "nutrition_basis",
    "energy_kcal",
    "protein_g",
    "carbs_g",
    "fat_g",
    "saturated_fat_g",
    "sugar_g",
    "fiber_g",
    "sodium_mg",
    "micronutrients",
    "ingredients",
    "allergens",
    "allergens_completeness_raw",
    "image_url",
    "source",
    "source_updated_at",
    "source_verified_on",
    "ingested_at",
    "confidence_score",
    "confidence_label_raw",
    "source_tier_raw",
    "off_atwater_dev_pct_raw",
    "cross_source_max_divergence_pct_raw",
    "note_raw",
    "quality_flags",
    "transformations",
    "raw_ref"
  ],
  "properties": {
    "product_id": {
      "type": "string",
      "pattern": "^qimmah_pkg_001:[0-9]{14}$"
    },
    "schema_version": {
      "type": "string",
      "enum": ["1.0.0"]
    },
    "normalization_version": {
      "type": "string",
      "enum": ["1.0.0"]
    },
    "gtin": {
      "type": "string",
      "pattern": "^[0-9]{14}$"
    },
    "gtin_as_source": {
      "type": "string",
      "pattern": "^[0-9]{8,14}$"
    },
    "name_ar": { "type": "string", "minLength": 1 },
    "name_en": { "type": "string", "minLength": 1 },
    "brand_ar": { "type": "string", "minLength": 1 },
    "brand_en": { "type": ["string", "null"] },
    "manufacturer": { "type": ["string", "null"] },
    "country": { "type": ["string", "null"] },
    "market": {
      "type": ["string", "null"],
      "enum": ["SA", "GCC", "GLOBAL", null]
    },
    "category_ar": { "type": "string", "minLength": 1 },
    "package_size_value": { "type": ["number", "null"], "exclusiveMinimum": 0 },
    "package_size_unit": {
      "type": ["string", "null"],
      "enum": ["g", "ml", null]
    },
    "package_size_text_raw": { "type": ["string", "null"] },
    "serving_size_value": { "type": ["number", "null"], "exclusiveMinimum": 0 },
    "serving_unit": {
      "type": ["string", "null"],
      "enum": ["g", "ml", null]
    },
    "serving_size_text_raw": { "type": ["string", "null"] },
    "servings_per_container": { "type": ["number", "null"], "exclusiveMinimum": 0 },
    "nutrition_basis": {
      "type": ["string", "null"],
      "enum": ["per_100g", "per_100ml", null]
    },
    "energy_kcal": { "type": "number", "minimum": 0, "maximum": 900 },
    "protein_g": { "type": "number", "minimum": 0, "maximum": 100 },
    "carbs_g": { "type": "number", "minimum": 0, "maximum": 100 },
    "fat_g": { "type": "number", "minimum": 0, "maximum": 100 },
    "saturated_fat_g": { "type": ["number", "null"], "minimum": 0, "maximum": 100 },
    "sugar_g": { "type": ["number", "null"], "minimum": 0, "maximum": 100 },
    "fiber_g": { "type": ["number", "null"], "minimum": 0, "maximum": 100 },
    "sodium_mg": { "type": ["number", "null"], "minimum": 0, "maximum": 40000 },
    "micronutrients": { "type": ["object", "null"] },
    "ingredients": { "type": ["string", "null"] },
    "allergens": {
      "type": ["array", "null"],
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "allergens_completeness_raw": { "type": "string", "minLength": 1 },
    "image_url": { "type": "null" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "batch",
        "source_record_id",
        "source_row_index",
        "source_urls",
        "source_path",
        "input_fingerprint_sha256"
      ],
      "properties": {
        "source_id": { "type": "string", "enum": ["qimmah_pkg_001"] },
        "batch": { "type": "string", "enum": ["PKG-001"] },
        "source_record_id": { "type": "string", "pattern": "^PKG-001:[0-9]{8,14}$" },
        "source_row_index": { "type": "integer", "minimum": 0 },
        "source_urls": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "format": "uri" }
        },
        "source_path": {
          "type": "string",
          "enum": ["docs/data-factory/packaged/PKG-001-saudi-gulf-packaged.json"]
        },
        "input_fingerprint_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "source_updated_at": { "type": "null" },
    "source_verified_on": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "ingested_at": { "type": "null" },
    "confidence_score": { "type": "null" },
    "confidence_label_raw": { "type": "string", "minLength": 1 },
    "source_tier_raw": {
      "type": "string",
      "enum": ["official+off", "off", "official+off_divergent"]
    },
    "off_atwater_dev_pct_raw": { "type": "number", "minimum": 0 },
    "cross_source_max_divergence_pct_raw": { "type": ["number", "null"], "minimum": 0 },
    "note_raw": { "type": ["string", "null"] },
    "quality_flags": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "allergens_unverified",
          "ingested_at_unset_deterministic_seed",
          "market_unverified",
          "nutrition_basis_unverified",
          "package_size_unparsed",
          "serving_size_unparsed",
          "source_divergence_review"
        ]
      }
    },
    "transformations": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "carbohydrates_g_to_carbs_g",
          "gtin_to_gtin14",
          "source_urls_compacted"
        ]
      }
    },
    "raw_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_path", "json_pointer", "raw_record_sha256", "input_fingerprint_sha256"],
      "properties": {
        "source_path": {
          "type": "string",
          "enum": ["docs/data-factory/packaged/PKG-001-saudi-gulf-packaged.json"]
        },
        "json_pointer": { "type": "string", "pattern": "^/items/[0-9]+$" },
        "raw_record_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "input_fingerprint_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    }
  }
}
