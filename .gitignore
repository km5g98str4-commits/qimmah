*.sln
*.sw?

# env
.env
.env.*
!.env.example
.vercel

# TS incremental build info (regenerated)
tsconfig.app.tsbuildinfo
# cf-pages-trigger

# agent worktrees (transient)
.claude/worktrees/

# كاش زحف WorkoutX المؤقت (استئناف p12-fetch-gifs) — لا يُلتزَم
scripts/.p12-catalog-cache.json

# local auth-e2e runtime workdir (Supabase config copy)
scripts/e2e-auth/.workdir/

# مجلّدا محاكاة النشرة (scripts/deploy-cutover-simulation.mjs) — مؤقّتان
.cutover-a/
.cutover-b/
.cutover-c/

# release-convergence build artifacts (scripts/release) — transient
dist-release/

# per-run release-convergence evidence snapshots (latest.json is tracked)
docs/execution/qimmah-postweb/release/evidence/run-*.json
.cslock-graph/

# خطّ إنتاج بيانات الأطعمة — تنزيلات ومخرجات وسيطة ضخمة (لا تُلتزم)
.food-cache/

# شرائح الأطعمة المُنتَجة — ~91 ميغابايت و160 ملفًّا، تُولَّد حتميًا ولا تُلتزم.
# بصماتها كلّها في data/food-production/manifests/build-manifest.json،
# وطريقة إعادة إنتاجها في data/food-production/accepted/README.md
data/food-production/accepted/shards/

# أصول بحث الطعام المولَّدة — ٤٦ ميغابايت مشتقّة من الشرائح بأمر واحد:
#   node scripts/food-production/emit-search-buckets.mjs
# حتمية بالبايت (merkle_root في search/manifest.json)، فلا معنى لإيداعها.
public/food/search/

# esbuild scratch bundles produced by proof runners
scripts/.*.bundle.mjs

# حالة Supabase CLI المحلّية — تكتبها الأداة عند أي `npx supabase …`.
# لا شأن لها بالمستودع، وقد تحمل حالةً مرتبطة بالمشروع المربوط. تُتجاهَل
# صراحةً بدل الاعتماد على أن ينتبه أحدٌ إليها في `git status` (rules/security.md).
supabase/.temp/
