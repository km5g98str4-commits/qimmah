# Gym OS Template — متغيرات البيئة
# انسخ هذا الملف إلى .env وعدّل القيم

# اسم المنتج (يظهر في الواجهة)
VITE_APP_NAME="Gym OS"

# رابط التواصل / واتساب لزر CTA (اختياري)
VITE_CONTACT_URL="https://wa.me/9665XXXXXXXX"

# رابط الشراء / Checkout (اختياري — يُفعّل لاحقًا)
VITE_CHECKOUT_URL=""

# المزامنة السحابية (Supabase) — اختياري.
# إن تُركا فارغين يعمل التطبيق محليًا (Guest Mode) دون مزامنة.
# قيم عامة آمنة للحقن في الحزمة (anon key مخصّص للعموم مع RLS).
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""
