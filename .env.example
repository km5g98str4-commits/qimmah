# قِمّة (Qimmah) — متغيرات البيئة
# انسخ هذا الملف إلى .env وعدّل القيم

# اسم المنتج (يظهر في الواجهة). الافتراضي في الكود «قِمّة».
VITE_APP_NAME="قِمّة"

# رابط التواصل / واتساب لزر CTA (اختياري)
VITE_CONTACT_URL="https://wa.me/9665XXXXXXXX"

# رابط الشراء / Checkout (اختياري — يُفعّل لاحقًا)
VITE_CHECKOUT_URL=""

# المصادقة/المزامنة السحابية (Supabase) — اختياري (override).
# التطبيق يأتي بمشروع Supabase عام مدمج (URL + anon key) داخل src/lib/supabaseClient.ts،
# لذا يعمل تسجيل الدخول افتراضيًا بلا أي إعداد. اضبط المتغيّرين أدناه فقط للتوجيه
# لمشروعك الخاص. القيم عامّة وآمنة للحقن في الحزمة (anon key مخصّص للعموم مع RLS).
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""

# — رابط استعادة كلمة المرور (Deep Link) —
# وجهة إعادة التوجيه لرابط «نسيت كلمة المرور» القادم من بريد Supabase.
# الويب: اتركه فارغًا — يُشتقّ تلقائيًا من أصل النشر + «#/reset».
# iOS/Android الأصلي: window.location.origin هو capacitor://localhost وغير صالح كوجهة بريد،
# فاضبطه على المخطّط المخصّص المُسجّل في التطبيق (Info.plist → CFBundleURLTypes):
#   VITE_RESET_REDIRECT_URL="com.qimmah.mobile://reset"
# أو نطاق Universal Link مُهيّأ (مثال): "https://qimmah.app/#/reset".
# أضِف نفس القيمة إلى Supabase → Authentication → URL Configuration → Redirect URLs.
# مستمع appUrlOpen (src/lib/deepLinkRecovery.ts) يلتقط الرابط ويوجّه إلى شاشة #/reset.
VITE_RESET_REDIRECT_URL=""

# — التحليلات (اختياري) —
# وجهة استقبال أحداث التحليلات المجهولة. يجب أن يكون رابط HTTPS صالحًا فقط.
# عند تركها فارغة — أو إن كانت غير صالحة أو غير HTTPS — لا يُرسَل أي شيء عبر الشبكة
# (المزوّد الافتراضي no-op؛ وفي التطوير تُطبع الأحداث في الـ console فقط). عند ضبط رابط
# HTTPS صالح يُفعَّل مزوّد HTTP الذي يرسل دفعات JSON عبر sendBeacon. الأحداث مجهولة بالكامل
# (معرّف عشوائي محلي فقط، بلا اسم/بريد/بيانات شخصية) ومضبوطة بموافقة المستخدم.
VITE_ANALYTICS_ENDPOINT=""

# — وسائط التمارين المتحرّكة (اختياري، وقت البناء فقط) —
# مفتاح WorkoutX لجلب عروض GIF متحرّكة موحّدة الأسلوب (Strong-style) لكل تمرين.
# ⚠ ليس VITE_* — يُستخدم فقط داخل سكربت البناء (scripts/build-exercise-media.mjs) على Node،
# ولا يُحقن في حزمة المتصفّح إطلاقًا. المنفذ (seam) جاهز: بلا مفتاح نعرض أفضل الإطارات الثابتة
# المتّسقة من free-exercise-db، ومع مفتاح تُفضّل الـ GIF المتحرّك. اتركه فارغًا افتراضيًا.
# التشغيل:  WORKOUTX_API_KEY=xxxx node scripts/build-exercise-media.mjs
WORKOUTX_API_KEY=""
